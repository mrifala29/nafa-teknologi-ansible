# --- Ansible runtime
*.retry
.ansible/

# --- Secrets / Vault
*.vault
*.vault.yml
vault_pass.txt
.vault_pass
secrets.yml

# --- SSH / Keys
*.pem
*.key
id_rsa*
id_ed25519*

# --- Inventory vars (seluruh group_vars & host_vars tidak di-commit)
inventories/*/group_vars/
inventories/*/host_vars/
# Exception: file .example boleh di-commit sebagai referensi
!inventories/*/group_vars/*.example
!inventories/*/host_vars/**/*.example

# --- OS
.DS_Store
Thumbs.db

# --- Editor
.vscode/
.idea/
*.swp
*.swo
